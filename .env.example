docker compose up --buildAPP_NAME=DepShield
APP_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
DATABASE_URL=postgresql+psycopg://depshield:change-me@localhost:5432/depshield
POSTGRES_PASSWORD=change-me
APP_SECRET=replace-this-with-at-least-32-random-bytes
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173
MAX_UPLOAD_BYTES=10485760
MAX_ARCHIVE_ENTRIES=2000
MAX_EXTRACTED_BYTES=52428800
SCAN_TIMEOUT_SECONDS=180
WORKER_POLL_SECONDS=2
OSV_BASE_URL=https://api.osv.dev
OSV_TIMEOUT_SECONDS=15
NVD_API_KEY=
NVD_ENABLED=true
CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
INTELLIGENCE_CACHE_HOURS=12
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DOCKER_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=45
SMTP_HOST=
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=depshield@localhost
RESET_TOKEN_TTL_MINUTES=30
DATA_RETENTION_DAYS=365
