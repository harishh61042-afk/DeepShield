{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "DepShield API",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    },
    {
      "name": "DepShield scan worker",
      "type": "debugpy",
      "request": "launch",
      "module": "app.workers.scan_worker",
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    }
  ]
}
