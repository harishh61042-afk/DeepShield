{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "DepShield: frontend dev server",
      "type": "shell",
      "command": "npm",
      "windows": { "command": "npm.cmd" },
      "args": ["run", "dev"],
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "DepShield: API",
      "type": "shell",
      "command": ".venv/bin/python",
      "windows": { "command": ".venv/Scripts/python.exe" },
      "args": ["-m", "uvicorn", "app.main:app", "--reload", "--host", "127.0.0.1", "--port", "8000"],
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "DepShield: scan worker",
      "type": "shell",
      "command": ".venv/bin/python",
      "windows": { "command": ".venv/Scripts/python.exe" },
      "args": ["-m", "app.workers.scan_worker"],
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "DepShield: tests, lint and build",
      "type": "shell",
      "command": "sh",
      "windows": { "command": "powershell", "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "scripts/test.ps1"] },
      "args": ["scripts/test.sh"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "DepShield: Docker Compose",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "up", "--build"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
